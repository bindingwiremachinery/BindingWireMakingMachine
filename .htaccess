# ------------------------------------------------------------------------------
# Apache Configuration for bindingwiremachine.in
# ------------------------------------------------------------------------------

# 1. Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Force Non-WWW to WWW (or vice-versa, matching canonical)
    RewriteCond %{HTTP_HOST} ^bindingwiremachine\.in [NC]
    RewriteRule ^(.*)$ https://www.bindingwiremachine.in/$1 [L,R=301]

    # Clean URL rewrites (serve .html without showing extension)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# 2. Gzip & Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 3. Browser Caching for Core Web Vitals (Lighthouse 95+)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 4. Custom Error Documents
ErrorDocument 404 /404.html
